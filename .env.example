# Telegram
TELEGRAM_BOT_TOKEN=
# Telegram user id allowed to run admin commands (/refresh)
ADMIN_TELEGRAM_USER_ID=

# Database (async SQLAlchemy URL)
# PostgreSQL (recommended, used by docker-compose):
DATABASE_URL=postgresql+asyncpg://ai_news_radar:ai_news_radar@postgres:5432/ai_news_radar
# SQLite (simple local prototype, no docker needed):
# DATABASE_URL=sqlite+aiosqlite:///./ai_news_radar.db

# LLM provider: "gemini" (Google Gemini API), "openai" (any OpenAI-compatible
# chat.completions API), or "mock" (no network calls, deterministic keyword heuristics)
LLM_PROVIDER=gemini
# Free API key from https://aistudio.google.com ("Get API key")
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
# Override the API base. Leave empty for the default endpoint of the selected provider
# (generativelanguage.googleapis.com for gemini, api.openai.com for openai). Useful for
# Azure OpenAI, a local vLLM/Ollama-compatible server, OpenRouter, etc.
LLM_API_BASE=

TIMEZONE=Asia/Almaty

# Daily digest send time, in TIMEZONE
DIGEST_HOUR=8
DIGEST_MINUTE=0

# How often the collection job runs
COLLECTION_INTERVAL_MINUTES=180

LOG_LEVEL=INFO
